# PostgreSQL
POSTGRES_USER=busfood
POSTGRES_PASSWORD=busfood
POSTGRES_DB=busfood
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://busfood:busfood@db:5432/busfood

# JWT
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Seed demo password (all seeded users share this password)
SEED_USER_PASSWORD=password123

# Seeded admin account. Leave ADMIN_PASSWORD empty to have the seed generate and print one.
ADMIN_PHONE=9000000001
ADMIN_NAME=DhabaGo Admin
ADMIN_PASSWORD=

# Google Places API
GOOGLE_PLACES_API_KEY=

# Gemini API
GEMINI_API_KEY=

# Orders (integer rupees / percent)
CONVENIENCE_FEE_INR=7
DEFAULT_COMMISSION_PCT=12

# Browser origins allowed to call the API (comma-separated); * allows any
CORS_ORIGINS=*
